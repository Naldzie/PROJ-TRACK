APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth login + Calendar auto-sync (project start / due / inspections).
# The app requests the calendar.events scope at login; enabling the Calendar
# API + test users on the Google Cloud consent screen is required for pushes.
# Without them, login still works and the UI falls back to Add-to-Google/.ics.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# E3 (2026-09-10): document/Excel parsing rides its own key + pinned model
# (fallbacks keep the shared AI_API_KEY/AI_MODEL when these are missing).
# Values are NEVER committed — paste real ones into local .env only.
AI_PARSER_API_KEY=
AI_PARSER_MODEL=gemini-2.5-flash

# E4 (2026-09-13): parser-only fallback ladder, tried in order when the parser
# model hits a per-model quota/overload/dead-id failure. Comma-separated, e.g.
# AI_PARSER_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
# NEVER list a Lite model here — Lite copies author summaries instead of
# computing (E3 verdict), which is the failure the S-curve paths excluded it for.
# Leave empty to keep the previous behaviour (no fallback on the parser paths).
AI_PARSER_FALLBACK_MODELS=

# E5 (2026-09-13): wall-clock seconds one AI parser call may spend in total,
# across the primary model's attempts and every fallback rung. Guards against
# PHP's max_execution_time killing the request mid-ladder — a FATAL cannot be
# caught, so the honest "the AI service is busy" message would never reach the
# user. Capped against PHP's own limit at runtime. Leave empty for the default.
AI_PARSER_TIME_BUDGET=50

# E6 (2026-09-13): seconds ONE attempt may take, per path — also the slot the
# time budget reserves before starting one. Two numbers because the payloads
# differ: the PDF path sends small page images (real answers measured at 8-10s),
# while the Excel path uploads the workbook itself (up to 15MB) and its ceiling
# is mostly transfer time. Lower the image value to let the fallback ladder
# reach more models inside the same budget; raise the text value if large
# workbooks start timing out.
AI_PARSER_IMAGE_TIMEOUT=15
AI_PARSER_TEXT_TIMEOUT=30
