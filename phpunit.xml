<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- E5 (2026-09-13): the suite must not inherit a developer's local AI
             fallback chain. Without these, a machine with AI_PARSER_FALLBACK_MODELS
             set in .env runs a DIFFERENT suite: tests that assert "Lite answered"
             see a version rung answer first and fail, on code that is perfectly
             correct. Found the hard way. Same class as the banked lesson that a
             live .env leaks its real key into parser_key — a config a test does not
             explicitly override is a config the environment gets to choose.
             Ladder tests set their own chain through config(), which wins. -->
        <env name="AI_PARSER_FALLBACK_MODELS" value=""/>
        <env name="AI_PARSER_TIME_BUDGET" value="50"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
